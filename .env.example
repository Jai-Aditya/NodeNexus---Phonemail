# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.

# ---- Secrets: make your own, e.g. with  openssl rand -hex 32  (Git Bash / Linux / Mac)
#      or in PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
# Shared secret between the API and the mail service. 32+ characters; the services
# refuse to start with a default or short value.
INTERNAL_TOKEN=
# Database password. Letters and digits only (it goes into a connection URL).
POSTGRES_PASSWORD=

MAIL_DOMAIN=phonemail.com

# auto     = Twilio Verify if the three TWILIO_* values below are set, else password login
# console  = one-time codes printed in `docker compose logs api` (development)
# twilio   = Twilio Verify only
# password = phone + password (the brief's fallback)
AUTH_MODE=auto

# From console.twilio.com (trial is fine; trial accounts only text verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Your Twilio phone number, for SMS alerts and sign-up texts, e.g. +15551234567
TWILIO_FROM_NUMBER=

# The public https address Twilio calls for the IVR/SMS webhooks (e.g. an ngrok URL).
PUBLIC_BASE_URL=

# Browser origins allowed to call the API (your frontend dev server), comma-separated.
CORS_ORIGINS=http://localhost:5173

# Set to false to stop "You have received an email" texts (saves trial credit).
SMS_ALERTS=true
# Country codes PhoneMail sends texts to (codes, alerts), comma-separated. Anything else
# is refused, which stops "SMS pumping" fraud to expensive foreign numbers.
SMS_COUNTRY_CODES=91

# ---- Production (behind nginx with https): set both to true.
# COOKIE_SECURE: the login cookie is only sent over https.
# TRUST_PROXY: read the visitor's address from nginx's X-Forwarded-For (last entry).
COOKIE_SECURE=false
TRUST_PROXY=false

# Where the API port listens: 127.0.0.1 (this computer only, the default) or 0.0.0.0
# (reachable from other devices, e.g. a phone on the same Wi-Fi, for testing).
# API_BIND=127.0.0.1

# Limits (defaults shown): emails per person, one SMS per chat per N minutes,
# attachment space per person.
# SEND_PER_MINUTE=30
# SEND_PER_DAY=500
# SMS_ALERT_MINUTES=10
# SMS_PER_SECOND=1      # alert texts per second from our number (US long code: 1; toll-free/short code: more)
# MAX_USER_STORAGE_MB=1024

# Ports on this computer (defaults shown); change one if something else already uses it.
# WEB_PORT=8080
# API_PORT=3000
# DB_PORT=5432
# MAILSVC_PORT=8081
# SMTP_PORT=2525
# POSTFIX_PORT=25

# ---- Mail to and from other providers ("SMTP local") ----
# The postfix container is the SMTP server in front of PhoneMail on machines without their own:
# mail for MAIL_DOMAIN arrives on 127.0.0.1:25 (POSTFIX_PORT) and goes to the mail service; the
# mail service hands outside mail to it (SMTP_RELAY=postfix:25). Leave both empty on a server
# with its own Postfix. Home connections usually block sending on port 25: then
# relay through a mail provider with POSTFIX_RELAYHOST=[smtp.example.com]:587 and its login.
COMPOSE_PROFILES=postfix
SMTP_RELAY=postfix:25
POSTFIX_RELAYHOST=
POSTFIX_RELAY_USER=
POSTFIX_RELAY_PASSWORD=
