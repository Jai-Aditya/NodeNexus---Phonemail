            "state": "translated",
            "value": "கோப்புறையை நீக்கு"
          }
        }
      }
    },
    "Delete my account": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरा खाता हटाएँ"
          }
        },
