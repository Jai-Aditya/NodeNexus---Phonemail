          }
        }
      }
    },
    "Forgot it? Use “Forgot password” on the sign-in page at mail.phonemail.net to set a new one with an SMS code.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भूल गए? mail.phonemail.net के साइन-इन पेज पर “पासवर्ड भूल गए” से SMS कोड के साथ नया पासवर्ड बनाएँ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மறந்துவிட்டீர்களா? mail.phonemail.net உள்நுழைவுப் பக்கத்தில் “கடவுச்சொல் மறந்துவிட்டதா” என்பதைப் பயன்படுத்தி, SMS குறியீட்டுடன் புதியதை அமைக்கலாம்."
          }
        }
      }
    },
    "From your contacts · %@": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके संपर्कों से · %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தொடர்புகளிலிருந்து · %@"
          }
        }
      }
    },
    "From: %@": {
      "extractionState": "manual",
      "localizations": {
