            "state": "translated",
            "value": "உதவி (பயனர் கையேடு)"
          }
        }
      }
    },
    "How would you like to verify this number?": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप यह नंबर कैसे सत्यापित करना चाहेंगे?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த எண்ணை எப்படிச் சரிபார்க்க விரும்புகிறீர்கள்?"
          }
        }
      }
    },
