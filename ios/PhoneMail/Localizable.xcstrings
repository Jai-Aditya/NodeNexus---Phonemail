          "stringUnit": {
            "state": "translated",
            "value": "புதிய கடவுச்சொற்கள் பொருந்தவில்லை"
          }
        }
      }
    },
    "Their emails will go to Spam. You can unblock them in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनके ईमेल स्पैम में जाएँगे। आप उन्हें सेटिंग्स में अनब्लॉक कर सकते हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்களின் மின்னஞ்சல்கள் ஸ்பேமுக்குச் செல்லும். அமைப்புகளில் அவர்களைத் தடைநீக்கலாம்."
          }
        }
