    },
    "Alias removed": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपनाम हटाया गया"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாற்றுப் பெயர் நீக்கப்பட்டது"
