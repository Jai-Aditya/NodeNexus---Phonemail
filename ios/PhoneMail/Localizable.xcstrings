    },
    "Until %@": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ तक"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ வரை"
          }
        }
      }
    },
    "Up to 40 characters.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम 40 अक्षर।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகபட்சம் 40 எழுத்துகள்."
          }
        }
      }
    },
    "Upload photo": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो अपलोड करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படத்தைப் பதிவேற்று"
          }
        }
      }
    },
    "Use a password instead": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बजाय पासवर्ड इस्तेमाल करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிலாகக் கடவுச்சொல்லைப் பயன்படுத்து"
          }
        }
      }
    },
    "Use my number bloom": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरा नंबर ब्लूम इस्तेमाल करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என் எண் மலரைப் பயன்படுத்து"
          }
        }
      }
    },
    "Use this picture": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह तस्वीर इस्तेमाल करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் படத்தைப் பயன்படுத்து"
          }
        }
      }
    },
    "Verify": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्यापित करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்"
          }
        }
      }
    },
    "Verify +91 %@": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "+91 %@ सत्यापित करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "+91 %@ ஐச் சரிபார்க்கவும்"
          }
        }
      }
    },
    "Verify by sending a text": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक SMS भेजकर सत्यापित करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு குறுஞ்செய்தி அனுப்பிச் சரிபார்க்கவும்"
          }
        }
      }
    },
    "Verify by sending a text instead": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बजाय SMS भेजकर सत्यापित करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிலாகக் குறுஞ்செய்தி அனுப்பிச் சரிபார்க்கவும்"
          }
        }
      }
    },
    "Waiting for your text… this continues by itself.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके SMS का इंतज़ार है… यह अपने आप आगे बढ़ेगा।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் குறுஞ்செய்திக்காகக் காத்திருக்கிறோம்… இது தானாகவே தொடரும்."
          }
        }
      }
    },
    "We verify the number with a text message. PhoneMail never calls you.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम नंबर को SMS से सत्यापित करते हैं। PhoneMail आपको कभी कॉल नहीं करता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எண்ணைக் குறுஞ்செய்தி மூலம் சரிபார்க்கிறோம். PhoneMail உங்களை ஒருபோதும் அழைக்காது."
          }
        }
      }
    },
    "Welcome to PhoneMail": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneMail में आपका स्वागत है"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneMail-க்கு வரவேற்கிறோம்"
          }
        }
      }
    },
    "With attachments": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अटैचमेंट वाले"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைப்புகள் உள்ளவை"
          }
        }
      }
    },
    "Write in full editor": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे एडिटर में लिखें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழு எடிட்டரில் எழுது"
          }
        }
      }
    },
    "Write your reply": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना जवाब लिखें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பதிலை எழுதுங்கள்"
          }
        }
      }
    },
    "Wrong password for this number": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस नंबर के लिए पासवर्ड गलत है"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த எண்ணுக்கான கடவுச்சொல் தவறு"
          }
        }
      }
    },
    "Wrong password, or this number has no password yet. Use a code by SMS instead.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड गलत है, या इस नंबर का अभी कोई पासवर्ड नहीं है। इसके बजाय SMS कोड इस्तेमाल करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடவுச்சொல் தவறு, அல்லது இந்த எண்ணுக்கு இன்னும் கடவுச்சொல் இல்லை. பதிலாக SMS குறியீட்டைப் பயன்படுத்தவும்."
          }
        }
      }
    },
    "Yesterday": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேற்று"
          }
        }
      }
    },
    "You": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள்"
          }
        }
      }
    },
    "You sign in with an SMS code. A password lets you sign in without one.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप SMS कोड से साइन इन करते हैं। पासवर्ड हो तो कोड के बिना भी साइन इन कर सकते हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் SMS குறியீட்டுடன் உள்நுழைகிறீர்கள். கடவுச்சொல் இருந்தால் குறியீடு இல்லாமலும் உள்நுழையலாம்."
          }
        }
      }
    },
    "Your PhoneMail address is your mobile number, like 9884690127@PhoneMail.Net.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका PhoneMail पता आपका मोबाइल नंबर है, जैसे 9884690127@PhoneMail.Net।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் PhoneMail முகவரி உங்கள் கைபேசி எண்தான், உதாரணமாக 9884690127@PhoneMail.Net."
          }
        }
      }
    },
    "Your address: %@": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पता: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முகவரி: %@"
          }
        }
      }
    },
    "Your contacts stay on this device. They are never uploaded.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके संपर्क इसी डिवाइस पर रहते हैं। वे कभी अपलोड नहीं होते।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தொடர்புகள் இந்தச் சாதனத்திலேயே இருக்கும். அவை ஒருபோதும் பதிவேற்றப்படாது."
          }
        }
      }
    },
    "Your default picture is drawn from your phone number — no two numbers bloom alike.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी डिफ़ॉल्ट तस्वीर आपके फ़ोन नंबर से बनती है — कोई भी दो नंबर एक जैसे नहीं खिलते।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இயல்புப் படம் உங்கள் தொலைபேசி எண்ணிலிருந்து வரையப்படுகிறது — எந்த இரண்டு எண்களும் ஒரே மாதிரி மலர்வதில்லை."
          }
        }
      }
    },
    "Your email address will be your number. We'll verify it with a text message.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ईमेल पता आपका नंबर होगा। हम इसे SMS से सत्यापित करेंगे।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மின்னஞ்சல் முகவரி உங்கள் எண்ணாகவே இருக்கும். அதைக் குறுஞ்செய்தி மூலம் சரிபார்ப்போம்."
          }
        }
      }
    },
    "Your emails are stored on PhoneMail's server in India and are never sold or shared.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके ईमेल भारत में PhoneMail के सर्वर पर रखे जाते हैं और कभी बेचे या साझा नहीं किए जाते।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மின்னஞ்சல்கள் இந்தியாவில் உள்ள PhoneMail சேவையகத்தில் சேமிக்கப்படுகின்றன; ஒருபோதும் விற்கப்படுவதோ பகிரப்படுவதோ இல்லை."
          }
        }
      }
    },
    "Your name": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका नाम"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பெயர்"
          }
        }
      }
    },
    "Your number bloom is back": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका नंबर ब्लूम वापस आ गया"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் எண் மலர் திரும்ப வந்துவிட்டது"
          }
        }
      }
    },
    "Your password": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पासवर्ड"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடவுச்சொல்"
          }
        }
      }
    },
    "to %@": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்கு"
          }
        }
      }
    }
  },
