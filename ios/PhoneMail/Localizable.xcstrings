          }
        }
      }
    },
    "New emails show on this device and on your Apple Watch. Reply or mark them read from the notification.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए ईमेल इस डिवाइस और आपकी Apple Watch पर दिखते हैं। सूचना से ही जवाब दें या उन्हें पढ़ा हुआ चिह्नित करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய மின்னஞ்சல்கள் இந்தச் சாதனத்திலும் உங்கள் Apple Watch-இலும் தோன்றும். அறிவிப்பிலிருந்தே பதிலளிக்கலாம் அல்லது படித்ததாகக் குறிக்கலாம்."
          }
        }
      }
    },
    "New folder": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया फ़ोल्डर"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய கோப்புறை"
          }
        }
      }
    },
    "New number? This creates your account. Already registered? It signs you in.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया नंबर? इससे आपका खाता बन जाएगा। पहले से रजिस्टर हैं? इससे आप साइन इन हो जाएँगे।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய எண்ணா? இது உங்கள் கணக்கை உருவாக்கும். ஏற்கெனவே பதிவுசெய்தவரா? இது உங்களை உள்நுழையச் செய்யும்."
          }
        }
      }
    },
    "New password (8+ characters)": {
      "extractionState": "manual",
      "localizations": {
