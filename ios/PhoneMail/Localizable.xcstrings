            "value": "ஒரு மின்னஞ்சலின் கோப்புகள் மொத்தம் 25 MB வரை இருக்கலாம்."
          }
        }
      }
    },
    "Find people you know": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जान-पहचान वालों को ढूँढें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்குத் தெரிந்தவர்களைக் கண்டறியுங்கள்"
          }
        }
      }
    },
    "Folder": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புறை"
          }
        }
