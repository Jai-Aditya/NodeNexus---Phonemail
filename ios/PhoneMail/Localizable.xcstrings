    "Files on one email can add up to 25 MB.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ईमेल की सभी फ़ाइलें मिलाकर 25 MB तक हो सकती हैं।"
          }
        },
        "ta": {
