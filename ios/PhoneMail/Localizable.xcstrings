    "Type a name to email someone; no need to remember numbers.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी को ईमेल करने के लिए बस नाम लिखें; नंबर याद रखने की ज़रूरत नहीं।"
