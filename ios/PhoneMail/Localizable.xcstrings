          }
        }
      }
    },
    "Signing in by text isn't available in the app. Use the code we text you, or a password.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में टेक्स्ट भेजकर साइन इन उपलब्ध नहीं है। हमारा भेजा SMS कोड या पासवर्ड इस्तेमाल करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப்பில் குறுஞ்செய்தி அனுப்பி உள்நுழைய முடியாது. நாங்கள் அனுப்பும் SMS குறியீட்டையோ கடவுச்சொல்லையோ பயன்படுத்துங்கள்."
          }
        }
      }
    },
