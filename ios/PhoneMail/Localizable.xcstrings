      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ரத்து செய்"
          }
        }
      }
    },
