      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब रद्द करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிலை ரத்து செய்"
          }
        }
      }
    },
    "Cancel send": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजना रद्द करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனுப்புவதை ரத்துசெய்"
          }
        }
      }
    },
    "Cannot reach PhoneMail. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneMail से संपर्क नहीं हो पा रहा। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneMail-ஐ அணுக முடியவில்லை. இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்."
          }
        }
      }
    },
    "Cc": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cc"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Cc"
          }
        }
      }
    },
    "Change number": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नंबर बदलें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எண்ணை மாற்று"
          }
        }
      }
    },
    "Change password": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड बदलें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடவுச்சொல்லை மாற்று"
          }
        }
      }
    },
    "Chat with %@": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से चैट करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ உடன் அரட்டை"
          }
        }
      }
    },
    "Chats show the names saved in your contacts.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट में वही नाम दिखेंगे जो आपके संपर्कों में सेव हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தொடர்புகளில் சேமித்த பெயர்களே அரட்டைகளில் தெரியும்."
          }
        }
      }
    },
    "Choose a conversation": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बातचीत चुनें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு உரையாடலைத் தேர்ந்தெடுக்கவும்"
          }
        }
      }
    },
    "Choose a password for your PhoneMail account.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने PhoneMail खाते के लिए पासवर्ड चुनें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் PhoneMail கணக்கிற்கு ஒரு கடவுச்சொல்லைத் தேர்வுசெய்யவும்."
          }
        }
      }
    },
    "Choose a style": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्टाइल चुनें"
          }
