    "No chats yet. Tap the pencil to write your first email.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई चैट नहीं। पहला ईमेल लिखने के लिए पेंसिल पर टैप करें।"
          }
        },
        "ta": {
