    "At most %lld files per email.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ईमेल में ज़्यादा से ज़्यादा %lld फ़ाइलें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு மின்னஞ்சலில் அதிகபட்சம் %lld கோப்புகள்."
          }
        }
      }
    },
    "Attach": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अटैच करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
