      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी ईमेल"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்து மின்னஞ்சல்களும்"
