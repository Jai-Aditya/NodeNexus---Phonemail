    "Confirm with a code we text you.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमारे भेजे SMS कोड से पुष्टि करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நாங்கள் அனுப்பும் SMS குறியீட்டால் உறுதிப்படுத்துங்கள்."
          }
        }
      }
    },
    "Confirm with your password.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पासवर्ड से पुष्टि करें।"
