            "value": "स्नूज़ हटाया गया"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தள்ளிவைப்பு நீக்கப்பட்டது"
          }
        }
      }
    },
    "Unstar": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
