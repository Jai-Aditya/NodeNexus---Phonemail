    "Notifications are off for PhoneMail. Turn them on in iOS Settings to hear about new emails.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneMail के लिए सूचनाएँ बंद हैं। नए ईमेल की ख़बर पाने के लिए उन्हें iOS सेटिंग्स में चालू करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneMail-க்கான அறிவிப்புகள் முடக்கத்தில் உள்ளன. புதிய மின்னஞ்சல்களைப் பற்றி அறிய iOS அமைப்புகளில் அவற்றை இயக்கவும்."
          }
        }
      }
    },
