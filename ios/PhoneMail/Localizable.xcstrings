{
  "sourceLanguage": "en",
  "strings": {
    "%@ is blocked. Their emails will go to Spam.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ब्लॉक हो गए। उनके ईमेल स्पैम में जाएँगे।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ தடுக்கப்பட்டார். அவர்களின் மின்னஞ்சல்கள் ஸ்பேமுக்குச் செல்லும்."
          }
        }
      }
    },
    "%@ is too big: files can be up to 25 MB.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बहुत बड़ी है: फ़ाइलें 25 MB तक हो सकती हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ மிகப் பெரியது: கோப்புகள் 25 MB வரை இருக்கலாம்."
          }
        }
      }
    },
    "%@ is unblocked": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अनब्लॉक हो गए"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ தடைநீக்கப்பட்டார்"
          }
        }
      }
    },
    "%lld attachments": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld अटैचमेंट"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld இணைப்புகள்"
          }
        }
      }
    },
    "%lld selected": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld चुने गए"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld தேர்ந்தெடுக்கப்பட்டன"
          }
        }
      }
    },
    "(no one yet)": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "(अभी कोई नहीं)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "(இன்னும் யாரும் இல்லை)"
          }
        }
      }
    },
    "(no subject)": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "(कोई विषय नहीं)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "(பொருள் இல்லை)"
          }
        }
      }
    },
    "1 attachment": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 अटैचमेंट"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "1 இணைப்பு"
          }
        }
      }
    },
    "6-digit code": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "6 अंकों का कोड"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "6 இலக்கக் குறியீடு"
          }
        }
      }
    },
    "Add": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேர்"
          }
        }
      }
    },
    "Add at least one recipient": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम एक प्राप्तकर्ता जोड़ें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறைந்தது ஒரு பெறுநரைச் சேர்க்கவும்"
          }
        }
      }
    },
    "Add more": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और जोड़ें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேலும் சேர்"
          }
        }
      }
    },
    "Add your name": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना नाम जोड़ें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பெயரைச் சேர்க்கவும்"
          }
        }
      }
    },
    "Agree and continue": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहमत हैं, आगे बढ़ें"
