          "stringUnit": {
            "state": "translated",
            "value": "इनबॉक्स"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்பாக்ஸ்"
          }
        }
      }
    },
    "Its conversations stay in All mail.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी बातचीत “सभी ईमेल” में बनी रहेंगी।"
          }
