        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதிலுள்ள உரையாடல்கள் “அனைத்து மின்னஞ்சல்களும்” பகுதியில் இருக்கும்."
          }
        }
      }
    },
