    "System follows your iPhone's light or dark setting.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“सिस्टम” चुनने पर ऐप आपके iPhone की लाइट या डार्क सेटिंग के अनुसार चलेगा।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“சாதன அமைப்பு” உங்கள் iPhone-இன் வெளிர் அல்லது அடர் அமைப்பைப் பின்பற்றும்."
          }
        }
      }
    },
    "Terms of Service": {
      "extractionState": "manual",
