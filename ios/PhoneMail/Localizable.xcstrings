      }
    },
    "Enter the 6-digit code we sent by SMS. Tap it above the keyboard when it arrives.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS से भेजा गया 6 अंकों का कोड डालें। कोड आने पर कीबोर्ड के ऊपर उस पर टैप करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS மூலம் அனுப்பிய 6 இலக்கக் குறியீட்டை உள்ளிடவும். அது வந்ததும் விசைப்பலகைக்கு மேலே தட்டவும்."
          }
        }
      }
    },
    "Enter your phone number": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना फ़ोन नंबर डालें"
