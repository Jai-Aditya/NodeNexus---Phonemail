    "People can also email you at an alias. Mail to it arrives in your chats.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोग आपको उपनाम पर भी ईमेल कर सकते हैं। उस पर आई मेल आपकी चैट में आएगी।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மக்கள் உங்கள் மாற்றுப் பெயருக்கும் மின்னஞ்சல் அனுப்பலாம். அது உங்கள் அரட்டைகளிலேயே வரும்."
          }
        }
      }
    },
    "People who don't have the app may get a text when you email them.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिनके पास ऐप नहीं है, उन्हें आपका ईमेल आने पर SMS मिल सकता है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலி இல்லாதவர்களுக்கு நீங்கள் மின்னஞ்சல் அனுப்பும்போது குறுஞ்செய்தி வரலாம்."
          }
        }
      }
    },
