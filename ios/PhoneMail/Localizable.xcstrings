    "Could not read %@.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पढ़ी नहीं जा सकी।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐப் படிக்க முடியவில்லை."
          }
        }
      }
    },
    "Could not read that photo.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह फ़ोटो पढ़ी नहीं जा सकी।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்தப் படத்தைப் படிக்க முடியவில்லை."
          }
        }
      }
    },
    "Couldn't send your reply. Open PhoneMail to try again.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका जवाब नहीं भेजा जा सका। फिर से कोशिश करने के लिए PhoneMail खोलें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பதிலை அனுப்ப முடியவில்லை. மீண்டும் முயல PhoneMail-ஐத் திறக்கவும்."
          }
        }
      }
    },
    "Current password": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा पासवर्ड"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்போதைய கடவுச்சொல்"
          }
        }
      }
    },
    "Dark": {
      "extractionState": "manual",
      "localizations": {
