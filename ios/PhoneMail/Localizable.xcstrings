        }
      }
    },
    "Sending to %lld people starts a group chat. Later emails to one of them stay in your one-to-one chat.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld लोगों को भेजने से ग्रुप चैट शुरू होगी। बाद में उनमें से किसी एक को भेजे ईमेल आपकी अलग चैट में ही रहेंगे।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld பேருக்கு அனுப்பினால் ஒரு குழு அரட்டை தொடங்கும். பின்னர் அவர்களில் ஒருவருக்கு அனுப்பும் மின்னஞ்சல்கள் தனி அரட்டையிலேயே இருக்கும்."
          }
        }
      }
    },
