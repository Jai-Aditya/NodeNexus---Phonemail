    "PhoneMail can use your contacts to suggest people when you write, and to show their names on your chats.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneMail आपके संपर्कों से लिखते समय लोगों के सुझाव दे सकता है और चैट में उनके नाम दिखा सकता है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எழுதும்போது நபர்களைப் பரிந்துரைக்கவும் அரட்டைகளில் அவர்களின் பெயர்களைக் காட்டவும் PhoneMail உங்கள் தொடர்புகளைப் பயன்படுத்தலாம்."
          }
        }
      }
