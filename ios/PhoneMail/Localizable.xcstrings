    },
    "Start your first email to %@. Add a subject, type your message and send.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को अपना पहला ईमेल लिखें। विषय जोड़ें, संदेश लिखें और भेजें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்கு உங்கள் முதல் மின்னஞ்சலைத் தொடங்குங்கள். பொருளைச் சேர்த்து, செய்தியைத் தட்டச்சு செய்து அனுப்புங்கள்."
          }
        }
      }
    },
    "Styles are applied on your device — only the picture you choose is uploaded.": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टाइल आपके डिवाइस पर ही लगते हैं — सिर्फ़ आपकी चुनी हुई तस्वीर अपलोड होती है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாணிகள் உங்கள் சாதனத்திலேயே பயன்படுத்தப்படுகின்றன — நீங்கள் தேர்ந்தெடுக்கும் படம் மட்டுமே பதிவேற்றப்படும்."
          }
        }
      }
    },
    "Subject": {
      "extractionState": "manual",
      "localizations": {
