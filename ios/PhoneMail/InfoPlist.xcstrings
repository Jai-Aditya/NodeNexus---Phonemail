{
  "sourceLanguage": "en",
  "strings": {
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneMail reads the names and phone numbers in your contacts to suggest people as you type (for example, type “Asha” to email Asha at her PhoneMail address) and to show their names on your chats. Your contacts stay on this device and are never uploaded."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneMail आपके संपर्कों के नाम और फ़ोन नंबर पढ़ता है, ताकि लिखते समय लोगों के सुझाव दे सके (जैसे “Asha” लिखें और Asha को उनके PhoneMail पते पर ईमेल करें) और चैट में उनके नाम दिखा सके। आपके संपर्क इसी डिवाइस पर रहते हैं और कभी अपलोड नहीं होते।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தட்டச்சு செய்யும்போது நபர்களைப் பரிந்துரைக்கவும் (எ.கா. “Asha” என்று தட்டச்சு செய்து Asha-வின் PhoneMail முகவரிக்கு மின்னஞ்சல் அனுப்பலாம்) அரட்டைகளில் அவர்களின் பெயர்களைக் காட்டவும் PhoneMail உங்கள் தொடர்புகளில் உள்ள பெயர்களையும் தொலைபேசி எண்களையும் படிக்கிறது. உங்கள் தொடர்புகள் இந்தச் சாதனத்திலேயே இருக்கும், ஒருபோதும் பதிவேற்றப்படாது."
          }
        }
      }
    }
  },
  "version": "1.0"
}
