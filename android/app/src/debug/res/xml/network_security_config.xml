<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may talk plain HTTP to the staging Pi on the home LAN (and the emulator's host). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.28.28.33</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- staging over Tailscale (jaihat26tops), for when the PC is away from the home network -->
        <domain includeSubdomains="false">100.117.120.84</domain>
    </domain-config>
</network-security-config>
