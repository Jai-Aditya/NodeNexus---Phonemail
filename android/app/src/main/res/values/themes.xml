<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#4B3FB0</color>
    <color name="brand_bg">#FFFFFF</color>

    <style name="Theme.PhoneMail" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowBackground">@color/brand_bg</item>
    </style>

    <!-- Shown while the app starts, then MainActivity switches to Theme.PhoneMail. -->
    <style name="Theme.PhoneMail.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PhoneMail</item>
    </style>
</resources>
