<?xml version="1.0" encoding="utf-8"?>
<!-- PhoneMail's logo, "Pip" the carrier pigeon with a letter (the web app's favicon.svg, 64-unit artwork), placed in
     the centre of the adaptive icon's 108dp canvas so it stays inside the 66dp safe zone. The indigo background
     comes from @color/brand. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="54" android:translateY="54">
        <group android:scaleX="1.08" android:scaleY="1.08">
            <group android:translateX="-32.8" android:translateY="-32.4">
                <!-- Pip in silhouette, facing right -->
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M40.5,13.5 C46.5,13.2 50.6,17.4 50.9,22.6 L56.8,25.2 L50.6,27.3 C51.4,34.8 47,41.8 38.6,44.4 C32,46.4 24.8,45.6 19.4,42.6 L8.6,47.6 L12.4,40.8 L6.8,36.4 L18.6,35.6 C21.6,29.6 27.4,26.4 31.4,25.4 C31.2,18.8 34.6,13.8 40.5,13.5 Z" />
                <!-- wing -->
                <path
                    android:fillColor="#C9C3F7"
                    android:pathData="M20.8,36.2 C26.6,30.2 36.4,29.6 43.2,33.2 C38.2,39.8 29,41.6 20.8,36.2 Z" />
                <!-- eye -->
                <path
                    android:fillColor="#4B3FB0"
                    android:pathData="M42.2,20.4 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" />
                <!-- legs -->
                <path
                    android:strokeColor="#F2A33A"
                    android:strokeWidth="2.2"
                    android:strokeLineCap="round"
                    android:pathData="M31.5,45.2 L30.4,51.2 M37.8,44.9 L38.4,51.2" />
                <!-- the letter, in its beak -->
                <group android:rotation="-8" android:pivotX="52" android:pivotY="34">
                    <path
                        android:fillColor="#F2A33A"
                        android:pathData="M47.2,28.8 h10.2 a1.6,1.6 0 0,1 1.6,1.6 v6.4 a1.6,1.6 0 0,1 -1.6,1.6 h-10.2 a1.6,1.6 0 0,1 -1.6,-1.6 v-6.4 a1.6,1.6 0 0,1 1.6,-1.6 Z" />
                    <path
                        android:strokeColor="#4B3FB0"
                        android:strokeWidth="1.4"
                        android:strokeLineJoin="round"
                        android:strokeLineCap="round"
                        android:pathData="M46.4,29.8 L52.3,34.2 L58.2,29.8" />
                </group>
            </group>
        </group>
    </group>
</vector>
